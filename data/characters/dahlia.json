{
  "name": "Dahlia",
  "title": "Ode and Oblation",
  "vision": "Hydro",
  "weapon": "Sword",
  "nation": "Mondstadt",
  "affiliation": "Church of Favonius",
  "rarity": 4,
  "constellation": "Cantus Choralis",
  "birthday": "0000-05-25",
  "description": "Deacon of the Church of Favonius and the Anemo Archon's representative in the church.",
  "skillTalents": [
    {
      "name": "Favonius Bladework - Ritual",
      "unlock": "Normal Attack",
      "description": "Normal Attack\nPerforms up to 4 rapid strikes.\n\nCharged Attack\nConsumes a certain amount of Stamina to unleash 2 rapid sword strikes.\n\nPlunging Attack\nPlunges from mid-air to strike the ground below, damaging opponents along the path and dealing AoE DMG upon impact.",
      "upgrades": [],
      "type": "NORMAL_ATTACK",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/talent-1.png"
    },
    {
      "name": "Immersive Ordinance",
      "unlock": "Elemental Skill",
      "description": "Time for a fun little trick! Summons the Sacramental Shower in different ways depending on whether you Tap or Hold it.\n\nTap\nAfter a short prayer, summons the Sacramental Shower in front.\n\nHold\nEngages in continuous prayer, and when done, summons forth a Sacramental Shower in the designated position.\n\nSacramental Shower\nWhen opponents or nearby party members touch the Sacramental Shower, different effects will occur depending on the one who touches it:\nIf an opponent touches the Shower, it will explode and deal AoE Hydro DMG to nearby opponents.\nIf a nearby party member touches it, it will bounce the one who touches it high in the air.\n\nOnly 1 Sacramental Shower summoned by Dahlia himself can be on the field at once.",
      "upgrades": [],
      "type": "ELEMENTAL_SKILL",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/talent-skill.png"
    },
    {
      "name": "Radiant Psalter",
      "unlock": "Elemental Burst",
      "description": "Appeals to the divine with earnestness and song, dealing AoE Hydro DMG to nearby opponents and granting his party members Favonian Favor, summoning a Shield of Sacred Favor.\nThe Shield of Sacred Favor's DMG absorption is based on Dahlia's Max HP, and it will absorb Hydro DMG with 250% effectiveness.\n\nFavonian Favor\nWhile this effect is active, 1 Benison stack may be consumed to summon a new Shield of Sacred Favor when an existing Shield is broken via DMG.\n\nDahlia can obtain Benison via the following methods:\n· He will gain 1 Benison stack when his own active party member hits opponents 4 times with Normal Attacks while affected by Favonian Favor.\n· After triggering the effect of his Ascension Talent, \"The Wind's Gentle Grace\" (You must first unlock this Ascension Talent.)\nDahlia can gain a maximum of 4 Benison stacks per Favonian Favor duration.",
      "upgrades": [],
      "type": "ELEMENTAL_BURST",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/talent-burst.png"
    }
  ],
  "passiveTalents": [
    {
      "name": "The Wind's Gentle Grace",
      "unlock": "Unlocked at Ascension 1",
      "description": "When characters affected by the Favonian Favor effect of the Elemental Burst {LINK#S11155}Radiant Psalter{/LINK} trigger Frozen reactions on opponents, they will grant Dahlia 2 Benison stacks. This effect can trigger once every 8s.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/talent-passive-1.png"
    },
    {
      "name": "Prayer of Well-Wrought Joy",
      "unlock": "Unlocked at Ascension 4",
      "description": "When your active party member is affected by the Favonian Favor effect of the Elemental Burst {LINK#S11155}\"Radiant Psalter,\"{/LINK} their ATK SPD will increase based on Dahlia's Max HP: Every 1,000 Max HP will cause an increase of 0.5%, up to a maximum of 20%.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/talent-passive-2.png"
    },
    {
      "name": "Pilgrimage Upon Returning Winds",
      "unlock": "Unlocked Automatically",
      "description": "During the day (06:00 – 18:00), your party members gain the Swift Stride effect: Movement SPD increased by 10%.\nDoes not take effect in Domains, Trounce Domains, or the Spiral Abyss. Swift Stride does not stack.",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/talent-passive-0.png"
    }
  ],
  "constellations": [
    {
      "name": "Infallible Procession",
      "unlock": "Constellation Lv. 1",
      "description": "Each time Dahlia gains 1 of his Elemental Burst {LINK#S11155}Radiant Psalter{/LINK}'s Benison stacks, he will regain 2.5 Elemental Energy.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/constellation-1.png"
    },
    {
      "name": "Revelation of Mercy",
      "unlock": "Constellation Lv. 2",
      "description": "After Dahlia consumes his Elemental Burst {LINK#S11155}Radiant Psalter{/LINK}'s Benison stacks to summon a Shield of Sacred Favor, the character protected by said Shield will gain 25% increased Shield Strength for 12s.",
      "level": 2,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/constellation-2.png"
    },
    {
      "name": "Windblume Offertory",
      "unlock": "Constellation Lv. 3",
      "description": "Increases the Level of {LINK#S11155}Radiant Psalter{/LINK} by 3.\nMaximum upgrade level is 15.",
      "level": 3,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/constellation-3.png"
    },
    {
      "name": "Collect of the Assembly",
      "unlock": "Constellation Lv. 4",
      "description": "The Favonian Favor from Dahlia's Elemental Burst {LINK#S11155}Radiant Psalter{/LINK} lasts 3 more seconds.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/constellation-4.png"
    },
    {
      "name": "Let It Be Subtly So",
      "unlock": "Constellation Lv. 5",
      "description": "Increases the Level of {LINK#S11152}Immersive Ordinance{/LINK} by 3.\nMaximum upgrade level is 15.",
      "level": 5,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/constellation-5.png"
    },
    {
      "name": "You Shall Go Out With Joy",
      "unlock": "Constellation Lv. 6",
      "description": "The current active character affected by the Elemental Burst {LINK#S11155}Radiant Psalter{/LINK}'s Favonian Favor has their ATK SPD increased by 10%.\nAdditionally, when an active character affected by Favonian Favor falls, immediately:\n· Revive them.\n· Restore their HP to 100%.\nThis effect can trigger once every 15 minutes.",
      "level": 6,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/dahlia/constellation-6.png"
    }
  ],
