      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-cryo/constellation-4.png"
    },
    {
      "name": "Bittercold Fog",
      "unlock": "Constellation Lv. 5",
      "description": "Increases the Level of the Elemental Skill {LINK#S10127}Ice Fog Piercer{/LINK} by 3.\nMaximum upgrade level is 15.",
      "level": 5,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-cryo/constellation-5.png"
    },
    {
      "name": "Brumal Grimfrost",
      "unlock": "Constellation Lv. 6",
      "description": "Every stack of {LINK#N10050002}Frostglow{/LINK} consumed when using the Elemental Burst {LINK#S10128}Frostbound Javelin{/LINK} increases Stellar Glimmer reaction DMG dealt by other party members by 5% for 15s. A maximum 40% increase can be obtained in this way.",
      "level": 6,
