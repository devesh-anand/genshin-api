      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/lisa/talent-skill.png"
    },
    {
      "name": "Lightning Rose",
      "unlock": "Elemental Burst",
      "description": "Summons a Lightning Rose that unleashes powerful lightning bolts, launching surrounding enemies and dealing Electro DMG.\n\nThe Lightning Rose will continuously emit lightning to knock back enemies and deal Electro DMG for so long as it persists.",
