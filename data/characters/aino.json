{
  "name": "Aino",
  "title": "Clinky-Clank Gadgets-A-Gogo",
  "vision": "Hydro",
  "weapon": "Claymore",
  "nation": "Nodkrai",
  "affiliation": "Clink-Clank Krumkake Craftshop",
  "rarity": 4,
  "constellation": "Cistellula Mira",
  "birthday": "0000-09-21",
  "description": "A genius mechanic and inventor from Nod-Krai who loves interesting machines and sweet treats.",
  "skillTalents": [
    {
      "name": "Bish-Bash-Bosh Repair",
      "unlock": "Normal Attack",
      "description": "Normal Attack\nPerforms up to 3 consecutive strikes.\n\nCharged Attack\nDrains Stamina over time to perform continuous spinning attacks against all nearby opponents.\nAt the end of the sequence, performs a more powerful slash. \n\nPlunging Attack\nPlunges from mid-air to strike the ground below, damaging opponents along the path and dealing AoE DMG upon impact.",
      "upgrades": [],
      "type": "NORMAL_ATTACK",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-1.png"
    },
    {
      "name": "Musecatcher",
      "unlock": "Elemental Skill",
      "description": "Aino throws a Musecatcher forward, dealing Hydro DMG and dragging her along behind it. When the dragging stops, Aino deals AoE Hydro DMG to nearby opponents.\nHolding the Skill will cause it to behave differently.\n\nHold\nEnter Aiming Mode to adjust the Musecatcher's throwing direction.",
      "upgrades": [],
      "type": "ELEMENTAL_SKILL",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-skill.png"
    },
    {
      "name": "Precision Hydronic Cooler",
      "unlock": "Elemental Burst",
      "description": "Aino deploys a custom water-spraying device, the Cool Your Jets Ducky to establish a Focused Hydronic Cooling Zone.\nWhile active, the Cool Your Jets Ducky will periodically fire water balls at nearby opponents, dealing Hydro DMG.",
      "upgrades": [],
      "type": "ELEMENTAL_BURST",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-burst.png"
    }
  ],
  "passiveTalents": [
    {
      "name": "Modular Efficiency Protocol",
      "unlock": "Unlocked at Ascension 1",
      "description": "Aino will be granted the corresponding buff effects based on the party's Moonsign.\n\nMoonsign: Ascendant Gleam: Her Elemental Burst Precision Hydronic Cooler is enhanced: The Cool Your Jets Ducky will fire water balls more frequently, and the water balls will deal AoE Hydro DMG over a larger area of effect.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-passive-1.png"
    },
    {
      "name": "Structured Power Booster",
      "unlock": "Unlocked at Ascension 4",
      "description": "Aino's Elemental Burst DMG is increased by 50% of her Elemental Mastery.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-passive-2.png"
    },
    {
      "name": "Moonsign Benediction: Force Limit Analysis",
      "unlock": "Unlocked Automatically",
      "description": "When Aino is in the party, the party's Moonsign will increase by 1 level.",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-passive-0.png"
    },
    {
      "name": "Miniaturized Detection Sensor",
      "unlock": "Unlocked Automatically",
      "description": "Displays the location of nearby resources unique to Nod-Krai on the mini-map.\nAdditionally, Aino appears to be able to alter the Cool Your Jets Ducky's appearance in some way...",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/talent-passive-extra-3.png"
    }
  ],
  "constellations": [
    {
      "name": "The Theory of Ash—Field Equilibrium",
      "unlock": "Constellation Lv. 1",
      "description": "After Aino uses her Elemental Skill Musecatcher or her Elemental Burst Precision Hydronic Cooler, her Elemental Mastery will be increased by 80. The Elemental Mastery of other nearby active party members will be increased by 80 for 15s.\n\nThe Elemental Mastery-increasing effects of this Constellation do not stack.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/constellation-1.png"
    },
    {
      "name": "The Principle of Transference in Gear Differentials",
      "unlock": "Constellation Lv. 2",
      "description": "If Aino is off-field while the Focused Hydronic Cooling Zone of her Elemental Burst Precision Hydronic Cooler is active, when your active party member hits a nearby opponent with an attack, the Cool Your Jets Ducky will fire an additional water ball at that opponent, dealing AoE Hydro DMG equal to 25% of Aino's ATK and 100% of her Elemental Mastery. This DMG is considered Elemental Burst DMG. This effect can be triggered once every 5s.",
      "level": 2,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/constellation-2.png"
    },
    {
      "name": "Cake and the Art of Mechanism Repair",
      "unlock": "Constellation Lv. 3",
      "description": "Increases the Level of Precision Hydronic Cooler by 3.\nMaximum upgrade level is 15.",
      "level": 3,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/constellation-3.png"
    },
    {
      "name": "Butter and Cats and the Law of Energy Supply",
      "unlock": "Constellation Lv. 4",
      "description": "When the Elemental Skill Musecatcher hits an opponent, it will restore 10 Elemental Energy for Aino. Energy can be restored to her in this manner once every 10s.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/constellation-4.png"
    },
    {
      "name": "Perpetual Turbine of Metal and Light",
      "unlock": "Constellation Lv. 5",
      "description": "Increases the Level of Musecatcher by 3.\nMaximum upgrade level is 15.",
      "level": 5,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/constellation-5.png"
    },
    {
      "name": "The Burden of Creative Genius",
      "unlock": "Constellation Lv. 6",
      "description": "For the next 15s after using the Elemental Burst Precision Hydronic Cooler, DMG from nearby active characters' Electro-Charged, Bloom, Lunar-Charged, Lunar-Bloom, and Lunar-Crystallize reactions is increased by 15%.\nMoonsign: Ascendant Gleam: DMG from the aforementioned reactions will be further increased by 20%.",
      "level": 6,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aino/constellation-6.png"
    }
  ],
