      "level": 3,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/jahoda/constellation-3.png"
    },
    {
      "name": "Wild Berry Amid the Dust",
      "unlock": "Constellation Lv. 4",
      "description": "When a {LINK#N11240002}Purrsonal Coordinated Assistance Robot{/LINK} from the Elemental Burst Hidden Aces: Seven Tools of the Hunter undergoes an Elemental Conversion, Jahoda will recover 4 Elemental Energy.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/jahoda/constellation-4.png"
    },
    {
      "name": "The Greatest Treasure",
