        },
        {
          "name": "Charged Attack DMG",
          "value": "Male: 55.9% + 72.2%\nFemale: 55.9% + 60.7%"
        },
        {
          "name": "Charged Attack Stamina Cost",
          "value": "20"
        },
        {
