          "value": "63.9%"
        },
        {
          "name": "Low / High Plunge DMG",
          "value": "128% / 160%"
        }
      ],
      "type": "NORMAL_ATTACK",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/traveler-anemo/talent-na.png"
    },
    {
      "name": "Palm Vortex",
      "unlock": "Elemental Skill",
      "description": "Grasping the wind's might, you form a vortex of vacuum in your palm, causing Anemo DMG 6 times in 1.5 seconds to opponents in front of you. The vacuum vortex explodes when the skill duration ends, causing a greater amount of Anemo DMG over a larger area.\nHold\nDMG and AoE will gradually increase.\nElemental Absorption\nIf the vortex comes into contact with Hydro/Pyro/Cryo/Electro elements, it will deal 23% additional elemental DMG of that type. Elemental Absorption may only occur once per use.\nGenerate 2 elemental particles when press and 3.5 when hold, if it hit at least 1 target.",
      "upgrades": [
        {
          "name": "Initial Cutting DMG% (x2)",
          "value": "12%"
        },
        {
          "name": "Max Cutting DMG% (x4)",
          "value": "16.8%"
        },
        {
          "name": "Initial Storm DMG%",
          "value": "176%"
        },
        {
          "name": "Max Storm DMG%",
          "value": "192%"
        },
        {
          "name": "CD",
          "value": "5 / 8s"
        }
      ],
      "type": "ELEMENTAL_SKILL",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/traveler-anemo/talent-skill.png"
    },
    {
      "name": "Gust Surge",
      "unlock": "Elemental Burst",
      "description": "Guiding the path of the wind currents, you summon a forward-moving tornado that pulls objects and opponents towards itself, dealing Anemo DMG each 0.5 seconds, 9 times.\nElemental Absorption\nIf the vortex comes into contact with Hydro/Pyro/Cryo/Electro elements, it will deal 30.7% additional elemental DMG of that type. Elemental Absorption may only occur once per use.",
      "upgrades": [
        {
          "name": "Tornado DMG% (x9)",
          "value": "80.8%"
        },
        {
          "name": "Additional Elemental DMG%",
          "value": "24.8%"
        },
        {
          "name": "Duration",
          "value": "6s"
        },
        {
          "name": "CD",
          "value": "15s"
        },
        {
          "name": "Energy Cost",
          "value": "60"
        }
      ],
      "type": "ELEMENTAL_BURST",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/traveler-anemo/talent-burst.png"
    }
  ],
  "passiveTalents": [
    {
      "name": "Slitting Wind",
      "unlock": "Unlocked at Ascension 1",
      "description": "The last hit of a Normal Attack combo unleashes a wind blade, dealing 60% of ATK as Anemo DMG to all opponents in its path.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/traveler-anemo/talent-passive-1.png"
    },
    {
      "name": "Second Wind",
      "unlock": "Unlocked at Ascension 4",
      "description": "Palm Vortex kills regenerate 2% HP for 5s.\nThis effect can only occur once every 5s.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/traveler-anemo/talent-passive-2.png"
    },
    {
      "name": "Foreign Windwrath",
      "unlock": "Unlocked Automatically",
      "description": "Draw new strength from journeys past. For every element you have resonated with, you gain additional buffs.\n\nAdditionally, when Pyro, Hydro, Cryo, or Electro attacks from nearby party members hit opponents, Traveler will receive 1 stack of Blade of the Dawn Breeze. Each Elemental Type can grant 1 Blade of the Dawn Breeze stack. After obtaining at least 2 stacks of Blade of the Dawn Breeze, performing a Charged Attack will consume all stacks of Blade of the Dawn Breeze and transform into the special Charged Attack: Whirlwind.\n\nCharged Attack: Whirlwind\n· Each Charged Attack hit deals increased Anemo DMG. Increase in DMG is equal to 60% of Traveler's ATK.\n· Every time a Blade of the Dawn Breeze of a certain elemental type is consumed, a Blade Wind matching this elemental type will also be summoned, dealing elemental DMG equal to 50% of Traveler's ATK. This DMG is considered Charged Attack DMG.\n· Charged Attack: Whirlwind can be triggered up to once every 15s.\n· For the duration of Charged Attack: Whirlwind, no Blade of the Dawn Breeze will be obtained.",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/traveler-anemo/talent-passive-extra-2.png"
    }
  ],
