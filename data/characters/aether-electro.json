  "birthday": "0000-00-00",
  "description": "A traveler from another world who had their only kin taken away, forcing them to embark on a journey to find The Seven.",
  "skillTalents": [
    {
      "name": "Foreign Thundershock",
      "unlock": "Normal Attack",
      "description": "Normal Attack\nPerforms up to 5 rapid strikes.\n\nCharged Attack\nConsumes a certain amount of Stamina to unleash 2 rapid sword strikes.\n\nPlunging Attack\nPlunges from mid-air to strike the ground below, damaging opponents along the path and dealing AoE DMG upon impact.",
      "upgrades": [],
      "type": "NORMAL_ATTACK",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-electro/talent-1.png"
    },
    {
      "name": "Lightning Blade",
      "unlock": "Elemental Skill",
      "description": "Unleashes three swift thunder shadows that deal Electro DMG to opponents and leave an Abundance Amulet behind after hitting an opponent.\n2 Abundance Amulets can be created initially. Using this skill will reset any Abundance Amulets that were generated.\n\nAbundance Amulets\nWhen a character is near an Abundance Amulet, they will absorb it and obtain the following effects:\n·Restores Elemental Energy\n·Increases Energy Recharge during the Abundance Amulet's duration.\n\nYou and Paimon discuss the paths by which electricity might flow.",
      "upgrades": [],
      "type": "ELEMENTAL_SKILL",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-electro/talent-skill.png"
    },
    {
      "name": "Bellowing Thunder",
      "unlock": "Elemental Burst",
      "description": "You call upon the protection of lightning, knocking nearby opponents back and dealing Electro DMG to them.\n\nLightning Shroud\nWhen your active character's Normal or Charged Attacks hit opponents, they will call Falling Thunder forth, dealing Electro DMG.\nWhen Falling Thunder hits opponents, it will regenerate Energy for that character.\nOne instance of Falling Thunder can be generated every 0.5s.\n\nYou and Paimon studied the light that flashes through the clouds.",
      "upgrades": [],
      "type": "ELEMENTAL_BURST",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-electro/talent-burst.png"
    }
  ],
  "passiveTalents": [
    {
      "name": "Thunderflash",
      "unlock": "Unlocked at Ascension 1",
      "description": "When another nearby character in the party obtains an Abundance Amulet created by Lightning Blade, Lightning Blade's CD is decreased by 1.5s.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-electro/talent-passive-1.png"
    },
    {
      "name": "Resounding Roar",
      "unlock": "Unlocked at Ascension 4",
      "description": "Increases the Energy Recharge effect granted by Lightning Blade's Abundance Amulet by 10% of the Traveler's Energy Recharge.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-electro/talent-passive-2.png"
    },
    {
      "name": "Foreign Thundertrail",
      "unlock": "Unlocked Automatically",
      "description": "Draw new strength from journeys past. For every element you have resonated with, you gain additional {LINK#N10050001}buffs{/LINK}.\n\nIn addition, when nearby party members unleash an Elemental Burst, Traveler will receive 1 stack of Blade of Resounding Thunder, max 3 stacks. After obtaining 3 stacks of Blade of Resounding Thunder, performing a Charged Attack will consume all stacks of Blade of Resounding Thunder and transform into the special Charged Attack: Detonate.\n\nCharged Attack: Detonate\n· Each Charged Attack hit deals increased Electro DMG. Increase in DMG is equal to 100% of Traveler's ATK. \n· 3s after hitting the enemy, 1 additional lightning strike will be triggered, dealing Electro DMG equal to 200% of Traveler's ATK. 1 Abundance Amulet will also be created. This DMG is considered Charged Attack DMG.\n· Charged Attack: Detonate can be triggered up to once every 15s.",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/aether-electro/talent-passive-0.png"
    }
  ],
