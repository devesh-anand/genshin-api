          "value": "43.9%"
        },
        {
          "name": "Fully-Charged Aimed Shot",
          "value": "124%"
        },
        {
          "name": "Plunge DMG",
          "value": "56.8%"
        },
        {
          "name": "Low / High Plunge DMG",
          "value": "114% / 142%"
        }
      ],
      "type": "NORMAL_ATTACK",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-na.png"
    },
    {
      "name": "Nightrider",
      "unlock": "Elemental Skill",
      "description": "Summons Oz, the night raven forged of darkness and lightning descends upon the land, dealing Electro DMG in a small AoE.\n\nFor the ability's duration, Oz will continuously attack nearby enemies with Freikugel.\nHold to adjust the location Oz will be summoned to.\n\nPress again any time during the ability's duration to once again summon him to Fischl's side.",
      "upgrades": [
        {
          "name": "Oz' ATK DMG",
          "value": "88.8%"
        },
        {
          "name": "Summoning DMG",
          "value": "115%"
        },
        {
          "name": "Oz's Duration",
          "value": "10s"
        },
        {
          "name": "CD",
          "value": "25s"
        }
      ],
      "type": "ELEMENTAL_SKILL",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-skill.png"
    },
    {
      "name": "Midnight Phantasmagoria",
      "unlock": "Elemental Burst",
      "description": "Summons Oz to spread his twin swings of twilight and defend Fischl.\n\nHas the following properties during the ability's duration:\n\nFischl takes on Oz's form, greatly increasing her Movement Speed.\nStrikes nearby enemies with lightning, dealing Electro DMG to enemies she comes into contact with. Each enemy can only be struck once.\nOnce this ability's effects end, Oz will remain on the battlefield and attack his Prinzessin's foes. If Oz is already on the field, then this will reset the duration of his presence.",
      "upgrades": [
        {
          "name": "Falling Thunder DMG",
          "value": "208%"
        },
        {
          "name": "CD",
          "value": "15s"
        },
        {
          "name": "Energy Cost",
          "value": "60"
        }
      ],
      "type": "ELEMENTAL_BURST",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-burst.png"
    }
  ],
  "passiveTalents": [
    {
      "name": "Stellar Predator",
      "unlock": "Unlocked at Ascension 1",
      "description": "When Fischl hits Oz with a fully-charged Aimed Shot, Oz brings down Thundering Retribution, dealing AoE Electro DMG equal to 152.7% of the arrow's DMG.",
      "level": 1,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-passive-1.png"
    },
    {
      "name": "Undone Be Thy Sinful Hex",
      "unlock": "Unlocked at Ascension 4",
      "description": "If your current active character triggers an Electro-related Elemental Reaction when Oz is on the field, the opponent shall be stricken with Thundering Retribution that deals Electro DMG equal to 80% of Fischl's ATK.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-passive-2.png"
    },
    {
      "name": "Mein Hausgarten",
      "unlock": "Unlocked Automatically",
      "description": "When dispatched on an expedition in Mondstadt, time consumed is reduced by 25%.",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-passive-0.png"
    },
    {
      "name": "Witch's Eve Rite: Phantasmal Nocturne",
      "unlock": "Unlocked Automatically",
      "description": "After completing Witch's Homework: Of the Unexpected, Fischl will become a Hexerei character. When the party includes at least 2 Hexerei characters, you will gain the Hexerei: Secret Rite effect, which enhances Hexerei characters.\n\nHexerei: Secret Rite\nHark, Prince Nachtraben, Ozvaldo Hrafnavins, he who has witnessed the fall of countless worlds. Sing now the starry septet for your sovereign, for this is the moment of deepest sin, when the gathered souls at the end of causality shatter the darkness of fate.\nAdditionally, when Oz is on the field, party members will gain additional buff effects:\n· After a nearby party member triggers an Overloaded reaction, Fischl and other nearby active party members have their ATK increased by 22.5% for 10s.\n· After a nearby party member triggers an Electro-Charged or Lunar-Charged reaction, Fischl and other nearby active party members have their Elemental Mastery increased by 90 for 10s.",
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/fischl/talent-passive-extra-3.png"
    }
  ],
  "constellations": [
