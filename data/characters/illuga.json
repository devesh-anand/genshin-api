      "level": 3,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/illuga/constellation-3.png"
    },
    {
      "name": "Solarhunting Wolf",
      "unlock": "Constellation Lv. 4",
      "description": "When Elemental Burst {LINK#S11275}Shadowless Reflection{/LINK}'s Haunted Night's Oriole-Song effect is active, nearby active party members will have their DEF increased by 200.",
      "level": 4,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/illuga/constellation-4.png"
    },
    {
      "name": "Hurricane Steed",
      "unlock": "Constellation Lv. 5",
      "description": "Increases the Level of Elemental Skill {LINK#S11272}Dawnbearing Songbird{/LINK} by 3.\nMaximum upgrade level is 15.",
      "level": 5,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/illuga/constellation-5.png"
    },
    {
      "name": "Nightmare Orioles",
      "unlock": "Constellation Lv. 6",
      "description": "Enhances the Lightkeeper's Oath effect of the Ascension Talent {LINK#P1272101}Torchforger's Covenant{/LINK}: For Geo DMG dealt to opponents, CRIT Rate is increased by 10%, CRIT DMG is increased by 30%.\n\nMoonsign: Ascendant Gleam:\nWhen characters are affected by Lightkeeper's Oath, Elemental Mastery is increased by 80.\nYou must first unlock the Ascension Talent \"Torchforger's Covenant.\"",
      "level": 6,
      "img": "https://pub-1ad979b6618d4a07ab871591a84b954c.r2.dev/illuga/constellation-6.png"
