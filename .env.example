PORT=5000

# Platform database (accounts, player data). Unset = game-data API only. See docs/database.md.
#   Railway: ${{Postgres.DATABASE_URL}}   local Postgres: postgres://…   no server: pglite://.pglite
# DATABASE_URL=pglite://.pglite

# Proxy hops in front of the app, for real client IPs (rate limiting). Railway = 1 (default).
# Set to "false" when running with no proxy in front and exposed directly.
# TRUST_PROXY=1

# Cloudflare R2 credentials — only needed for scripts/ (populate-characters, sync, image-variants)
R2_ID=
AWS_ID=
AWS_KEY=
